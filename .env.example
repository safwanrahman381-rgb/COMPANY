# Copy this file to .env and fill it in. Never commit .env.

# Port the server listens on (most hosts set this for you).
PORT=3000

# Set to "production" on your live server. In production, checkout refuses to run without Stripe keys.
NODE_ENV=development

# Your site's public address, used for Stripe's return links, e.g. https://www.yourshop.co.uk
PUBLIC_URL=

# Stripe keys: https://dashboard.stripe.com/apikeys  (use sk_test_... until you're ready to go live)
STRIPE_SECRET_KEY=
# Webhook signing secret: https://dashboard.stripe.com/webhooks  (endpoint: https://yourdomain/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Password for the admin dashboard at /admin. Use something long and random.
ADMIN_PASSWORD=

# Optional: folder for orders, messages and stock on a persistent disk (defaults to ./data).
DATA_DIR=
